# 环境配置（dev/example/prod 三份保持一致；生产环境务必替换真实密钥，勿提交到仓库）
PROJECT_NAME='LlamaIndex学习'
POSTGRESQL='postgresql+asyncpg://duoduo:xcb123#@localhost:5432/postgres'

# ---------------- 日志 ----------------
LOG_LEVEL='INFO'                    # 根日志器级别（DEBUG/INFO/WARNING/ERROR）
LOG_RETENTION_DAYS=90               # 日志文件保留天数（按天滚动清理）

# ---------------- 认证/JWT ----------------
JWT_SECRET=''                       # JWT签名密钥（≥32字符），生产必须通过配置中心下发
AT_TTL=1800                         # Access Token有效期（秒）
RT_SLIDING_TTL=2592000              # Refresh Token滑动有效期（秒，默认30天）
RT_MAX_LIFETIME=7776000             # Refresh Token绝对最大寿命（秒，默认90天）
RENEW_THRESHOLD=300                 # AT滑动续期触发阈值（秒）
RT_GRACE=0                          # RT重用宽限窗口（秒，0=关闭，推荐关闭）
AUTH_COOKIE_SECURE=false            # 生产必须true（RT Cookie仅HTTPS）
AUTH_COOKIE_PATH=/                  # RT Cookie路径；经前端代理(/api)访问时可设为/
REDIS_URL='redis://localhost:6379/0'  # Redis连接；留空降级进程内存存储（仅限本地开发）
USER_STATE_CACHE_TTL=3600           # 用户版本号/状态缓存TTL（秒），改密/禁用时主动失效

# ---------------- 文件处理任务 ----------------
TASK_BACKEND='bullmq'               # 任务框架后端：bullmq（Redis队列）/ inline（进程内直执行）
TASK_CONCURRENCY=2                  # 应用内任务并发消费数
TASK_MAX_ATTEMPTS=3                 # 任务失败自动重试次数（指数退避）
TASK_BACKOFF_DELAY=2000             # 任务重试指数退避基础延迟（毫秒）
TASK_KEEP_FAILED=500                # 失败任务保留最近N条便于排障

# ---------------- MinIO 对象存储 ----------------
MINIO_ENDPOINT='localhost:9000'     # MinIO服务地址（本地启动默认localhost:9000）
MINIO_ACCESS_KEY='minioadmin'       # MinIO访问密钥（本地默认minioadmin）
MINIO_SECRET_KEY='minioadmin'       # MinIO秘密密钥（本地默认minioadmin）
MINIO_BUCKET='lingshu'              # 存储桶名（不存在时自动创建）
MINIO_SECURE=false                  # 是否HTTPS（本地MinIO为false）

# ---------------- Docling 解析服务 ----------------
DOCLING_BASE_URL='http://localhost:5001'  # docling-serve服务地址（本地部署默认5001端口）
DOCLING_TIMEOUT=300                 # Docling解析请求超时（秒），OCR/大文档耗时较长
DOCLING_CONNECT_TIMEOUT=10          # Docling连接超时（秒），服务冷启动较慢

# ---------------- 向量数据库（Milvus） ----------------
MILVUS_URI='http://localhost:19530' # Milvus服务地址（本地standalone默认19530端口）
MILVUS_DIM=1024                     # 向量维度（bge-m3为1024），仅首次创建collection时使用
RETRIEVAL_TOP_K=20                  # 向量相似度检索默认返回条数

# ---------------- 全文检索（Elasticsearch） ----------------
ES_URL='http://localhost:9200'      # Elasticsearch服务地址（本地部署默认9200端口）
ES_USERNAME=''                      # ES用户名（本地未启用认证时留空）
ES_PASSWORD=''                      # ES密码（本地未启用认证时留空）
ES_REQUEST_TIMEOUT=60               # ES请求超时（秒）

# ---------------- 模型服务（OpenAI兼容协议） ----------------
MODEL_CONNECT_TIMEOUT=10            # 模型服务连接超时（秒），连接慢的私有网关可放宽
MODEL_READ_TIMEOUT=20               # 模型目录拉取读取超时（秒）
MODEL_REQUEST_TIMEOUT=60            # 模型推理请求（rerank等）整体超时（秒）

# ---------------- 知识图谱（OpenSPG/KAG） ----------------
KAG_OPENSPG_URL='http://localhost:8887'  # OpenSPG(KAG)引擎地址，策略graph=True时构建图谱
KAG_NEO4J_URI='neo4j://release-openspg-neo4j:7687'  # KAG创建项目config的Neo4j地址（KAG服务端可达）
KAG_NEO4J_USER='neo4j'              # KAG后端Neo4j用户名
KAG_NEO4J_PASSWORD='neo4j@openspg'  # KAG后端Neo4j密码，生产必须通过配置下发
KAG_EMBEDDING_BASE_URL='http://host.docker.internal:11434/v1'  # KAG项目vectorizer地址（KAG服务端容器可达）
KAG_EMBEDDING_MODEL='bge-m3:latest'  # KAG项目vectorizer模型名
KAG_EMBEDDING_MODEL_ID='9ec07a0c0be2491d9d272d2d8cae547c@bge-m3:latest'  # 服务端已注册的模型ID
